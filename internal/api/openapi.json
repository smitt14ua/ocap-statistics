{
  "openapi": "3.0.3",
  "info": {
    "title": "OCAP Statistics API",
    "version": "1.0.0",
    "description": "Pre-computed player, squad and rotation statistics built from OCAP recordings. The service ingests every recording from OCAP once and answers from its own database.\n\nAll statistics endpoints accept the common filter parameters `from`, `to`, `tag` and `min_duration`. Responses are cached and carry an `ETag`; send `If-None-Match` to get `304 Not Modified` while the data is unchanged.\n\nCustom columns are defined by the site administrator with formulas; their values appear in the `custom` object of players and squads, keyed by the column ids listed in `/api/v1/config`.\n\nErrors are returned as `{\"error\": \"human readable message\", \"code\": \"machine_readable_code\"}`."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Statistics"
    },
    {
      "name": "Missions"
    },
    {
      "name": "Service"
    }
  ],
  "paths": {
    "/api/v1/stats": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "Everything for a period in one call: totals, players, squads and achievements",
        "parameters": [
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "totals": {
                      "$ref": "#/components/schemas/Totals"
                    },
                    "players": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Player"
                      }
                    },
                    "squads": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Squad"
                      }
                    },
                    "achievements": {
                      "$ref": "#/components/schemas/Achievements"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/players": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "Player leaderboard",
        "parameters": [
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive substring of the player name"
          },
          {
            "$ref": "#/components/parameters/squad"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "kills, deaths, teamKills, vehiclesDestroyed, killAssists, attendance, accuracy, kd, shotsFired, hits, name, squad or custom.<column id>. Without it the default sort configured by the administrator is used (see /api/v1/config)."
          },
          {
            "$ref": "#/components/parameters/order"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/format"
          }
        ],
        "responses": {
          "200": {
            "description": "OK (JSON, or CSV with format=csv)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "missions": {
                      "type": "integer",
                      "description": "Number of counted missions"
                    },
                    "total": {
                      "type": "integer",
                      "description": "Number of players before pagination"
                    },
                    "players": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Player"
                      }
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/players/{name}": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "Player profile: totals, mission history, weapons, victims and killers",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Player name without the squad prefix"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "player": {
                      "$ref": "#/components/schemas/Player"
                    },
                    "squads": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Count"
                      },
                      "description": "Squads the player played in, with mission counts"
                    },
                    "weapons": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Count"
                      },
                      "description": "Top 10 weapons by kills"
                    },
                    "victims": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Count"
                      },
                      "description": "Players killed most often"
                    },
                    "killedBy": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Count"
                      },
                      "description": "Players who killed this player most often"
                    },
                    "longestKill": {
                      "$ref": "#/components/schemas/Kill"
                    },
                    "missions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlayerMission"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/squads": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "Squad leaderboard",
        "description": "A player's results count towards the squad they played in during each mission. Players without a squad are the entry with `name: \"\"`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/squad"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "kills, deaths, teamKills, vehiclesDestroyed, killAssists, attendance, players, accuracy, kd, score, name or custom.<column id>. Without it the default sort configured by the administrator is used (see /api/v1/config)."
          },
          {
            "$ref": "#/components/parameters/order"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/format"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "missions": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "squads": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Squad"
                      }
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/squads/{name}": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "A squad and its members (only missions played in this squad)",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Squad tag without brackets, e.g. ALPHA. `-` selects players without a squad."
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "squad": {
                      "$ref": "#/components/schemas/Squad"
                    },
                    "members": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Player"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/achievements": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "Achievements of a period",
        "parameters": [
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "achievements": {
                      "$ref": "#/components/schemas/Achievements"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rotation": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "Rotation score and match log",
        "description": "Rotation sides are groups of squads defined in the settings. A side wins a mission when the winner of the `endMission` event names the in-game side (EAST, WEST, ...) most of its players were on; any other mission is a draw.",
        "parameters": [
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "rotation": {
                      "$ref": "#/components/schemas/Rotation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/missions": {
      "get": {
        "tags": [
          "Missions"
        ],
        "summary": "Processed missions of a period, newest first",
        "parameters": [
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/min_duration"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "$ref": "#/components/schemas/Filter"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "missions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Mission"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/missions/{id}": {
      "get": {
        "tags": [
          "Missions"
        ],
        "summary": "Statistics of one mission: players, squads and kills",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "OCAP recording id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mission": {
                      "$ref": "#/components/schemas/Mission"
                    },
                    "counted": {
                      "type": "boolean",
                      "description": "Whether the mission counts towards statistics (duration ≥ minDuration)"
                    },
                    "players": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MissionPlayer"
                      }
                    },
                    "squads": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Squad"
                      }
                    },
                    "kills": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Kill"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Ingestion status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "missions": {
                      "$ref": "#/components/schemas/Counts"
                    },
                    "sync": {
                      "$ref": "#/components/schemas/SyncStatus"
                    },
                    "generation": {
                      "type": "integer",
                      "description": "Changes whenever the statistics change"
                    },
                    "build": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "commit": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Public settings: title, logo, default tag, minimum duration, rotation sides, custom columns and default sort",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/sync": {
      "post": {
        "tags": [
          "Service"
        ],
        "summary": "Queue a sync now (requires adminToken)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "202": {
            "description": "Queued"
          },
          "401": {
            "description": "Wrong token, or adminToken is not configured"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "from": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Start of the period (YYYY-MM-DD, inclusive). Unbounded by default."
      },
      "to": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "End of the period (YYYY-MM-DD, inclusive). Unbounded by default."
      },
      "tag": {
        "name": "tag",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "OCAP mission tag (exact match). Without the parameter the configured default tag is used; `*` selects all tags."
      },
      "min_duration": {
        "name": "min_duration",
        "in": "query",
        "schema": {
          "type": "number"
        },
        "description": "Minimum mission duration in seconds (configured default: 1200 = 20 min)."
      },
      "squad": {
        "name": "squad",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated squads, e.g. `ALPHA,BRAVO`. `-` selects players without a squad."
      },
      "order": {
        "name": "order",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "desc",
            "asc"
          ],
          "default": "desc"
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0
        },
        "description": "0 means no limit"
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "format": {
        "name": "format",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv"
          ],
          "default": "json"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Filter": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "minDuration": {
            "type": "number"
          }
        }
      },
      "Totals": {
        "type": "object",
        "properties": {
          "missions": {
            "type": "integer"
          },
          "players": {
            "type": "integer"
          },
          "squads": {
            "type": "integer"
          },
          "kills": {
            "type": "integer"
          },
          "deaths": {
            "type": "integer"
          },
          "teamKills": {
            "type": "integer"
          },
          "vehiclesDestroyed": {
            "type": "integer"
          },
          "killAssists": {
            "type": "integer"
          }
        }
      },
      "Counts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "done": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "error": {
            "type": "integer"
          },
          "missing": {
            "type": "integer",
            "description": "Recordings whose data file OCAP no longer has"
          }
        }
      },
      "SyncStatus": {
        "type": "object",
        "properties": {
          "running": {
            "type": "boolean"
          },
          "task": {
            "type": "string",
            "enum": [
              "sync",
              "recompute",
              "resync"
            ]
          },
          "progress": {
            "type": "object",
            "properties": {
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "queued": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastStart": {
            "type": "string",
            "format": "date-time"
          },
          "lastFinish": {
            "type": "string",
            "format": "date-time"
          },
          "lastSuccess": {
            "type": "string",
            "format": "date-time"
          },
          "lastError": {
            "type": "string"
          },
          "lastProcessed": {
            "type": "integer"
          },
          "lastFailed": {
            "type": "integer"
          },
          "nextRun": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name without the squad prefix"
          },
          "squad": {
            "type": "string",
            "description": "Squad of the latest mission in the period, empty when it was played without a squad (normalized, aliases applied)"
          },
          "squadRaw": {
            "type": "string",
            "description": "Squad as captured from the nickname, before aliases"
          },
          "kills": {
            "type": "integer"
          },
          "deaths": {
            "type": "integer"
          },
          "teamKills": {
            "type": "integer"
          },
          "vehiclesDestroyed": {
            "type": "integer"
          },
          "shotsFired": {
            "type": "integer"
          },
          "hits": {
            "type": "integer"
          },
          "attendance": {
            "type": "integer",
            "description": "Number of missions"
          },
          "accuracy": {
            "type": "number",
            "description": "hits / shots × 100"
          },
          "kd": {
            "type": "number",
            "description": "kills / deaths (kills when there are no deaths)"
          },
          "firstSeen": {
            "type": "string",
            "format": "date"
          },
          "lastSeen": {
            "type": "string",
            "format": "date"
          },
          "killAssists": {
            "type": "integer",
            "description": "Kills made by another crew member of the vehicle the player was in"
          },
          "custom": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "nullable": true
            },
            "description": "Custom column values by column id (see /api/v1/config); null when undefined, e.g. after a division by zero"
          }
        }
      },
      "Squad": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "\"\" for players without a squad"
          },
          "players": {
            "type": "integer"
          },
