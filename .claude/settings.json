{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt -l:*)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make build)",
      "Bash(node --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(make check)",
      "Bash(make check-web)",
      "Bash(npx --yes html-validate@9:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
