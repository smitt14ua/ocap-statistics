# Copy to .env and adjust. Every setting can also be given in config.json (see
# config.example.json); environment variables take precedence.

# --- Required -------------------------------------------------------------------------
# Base URL of your OCAP web server (used to list recordings).
OCAPSTATS_OCAP_URL=https://ocap.example.com

# First admin user of the admin panel (/admin/). Created once; the password can then be
# changed in the panel. Set OCAPSTATS_ADMIN_PASSWORD_RESET=true to force this password again.
OCAPSTATS_ADMIN_USERNAME=admin
OCAPSTATS_ADMIN_PASSWORD=change-me-please
# OCAPSTATS_ADMIN_PASSWORD_RESET=false

# --- Recordings -------------------------------------------------------------------------
# Read recordings from OCAP's data directory instead of downloading them (mount it read-only).
# OCAPSTATS_OCAP_DATA_DIR=/ocap-data
# Bearer token if your OCAP instance is not in public mode.
# OCAPSTATS_OCAP_TOKEN=
# Only ingest these tags (comma-separated, exact match). Empty = all tags.
# OCAPSTATS_SYNC_TAGS=COOP
# Only ingest recordings from this date.
# OCAPSTATS_SYNC_SINCE=2026-01-01
# OCAPSTATS_SYNC_INTERVAL=10m
# OCAPSTATS_SYNC_CONCURRENCY=2
# OCAPSTATS_SYNC_REQUEST_DELAY=500ms
# OCAPSTATS_SYNC_ENABLED=true

# --- Statistics (also editable in the admin panel) --------------------------------------
# Tag used by the site and the API when none is requested. Empty = all tags.
# OCAPSTATS_DEFAULT_TAG=COOP
# Missions shorter than this (seconds) are not counted.
# OCAPSTATS_MIN_DURATION=1200
# Regex for the squad in nicknames; group 1 is the squad.
# OCAPSTATS_SQUAD_PATTERN=\[~?(.*?)~?\]\s*
# OCAPSTATS_ROTATION_SINCE=2026-01-01

# --- Site ---------------------------------------------------------------------------------
# OCAPSTATS_UI_TITLE=OCAP Statistics
# OCAPSTATS_UI_LOGO_URL=https://example.com/logo.png
# Public OCAP address for "open replay" links (defaults to OCAPSTATS_OCAP_URL).
# OCAPSTATS_UI_OCAP_URL=https://ocap.example.com

# --- Service --------------------------------------------------------------------------------
# Set to true when the service is only reachable through a reverse proxy (Traefik, nginx,
# Caddy, ...). Client addresses and HTTPS detection then come from X-Forwarded-* headers.
# OCAPSTATS_TRUST_PROXY=false
# Log level (debug, info, warn, error) and format (text or json).
# OCAPSTATS_LOG_LEVEL=info
# OCAPSTATS_LOG_FORMAT=text
# OCAPSTATS_LISTEN=0.0.0.0:5080
# OCAPSTATS_DB=/data/stats.db
# Bearer token for scripts: POST /api/v1/sync and the admin API.
# OCAPSTATS_ADMIN_TOKEN=
# OCAPSTATS_ADMIN_SESSION_TTL=168h
